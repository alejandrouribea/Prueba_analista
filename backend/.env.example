# Copie este archivo como .env para sobreescribir la configuracion por defecto.
# Todos los valores son opcionales: la aplicacion arranca sin .env.

# Origenes permitidos para CORS (separados por coma)
CONCILIADOR_CORS_ORIGENES=http://localhost:4200,http://127.0.0.1:4200

# Tolerancia en pesos al comparar valores monetarios
CONCILIADOR_TOLERANCIA_PESOS=1
